# Power BI dashboard file
*.pbix

# CSV data files
*.csv

# README and documentation (keep tracked)
!README.md

# System files (macOS and Windows)
.DS_Store
Thumbs.db
desktop.ini

# Logs and temp files
*.log
*.tmp

# IDE/editor folders (optional)
.vscode/
.idea/

git rm --cached *.pbix
git rm --cached *.csv

git commit -m "Clean up tracked files now ignored by .gitignore"

git push
